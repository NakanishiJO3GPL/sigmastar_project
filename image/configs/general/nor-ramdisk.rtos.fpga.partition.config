# this config is for chip bringup
# kernel
# rootfs ——> squashfs
# miservice ——> squashfs
# customer ——> jffs2

# image info
IMAGE_LIST				=	boot kernel ramdisk misc miscL rtos rootfs miservice customer
#boot
BOOT_IMAGE_LIST			= ipl cis ipl_cust uboot
# ipl ipl_cust cis uboot
OTA_IMAGE_LIST			=	boot kernel misc miservice customer
USR_MOUNT_BLOCKS		=	misc miscL miservice customer

# flash info
FLASH_TYPE				=	nor
FLASH_BLK_SIZE			=	0x10000
FLASH_BLK_CNT			=	256
FLASH_PG_SIZE			=	0x1000
ifeq ($(UBOOT_VERSION), 201501)
MTDPARTS				=	"mtdparts=nor0:$(boot$(MTDPART)),$(cis$(SYSTAB))"
else
MTDPARTS				=	"nor0:$(boot$(MTDPART)),$(cis$(SYSTAB))"
endif

# bootcmd
BOOTCMD_ENV			=	sf probe 0\; $(rtos$(BOOTCMD))

# cis
cis$(RESOURCE)			=	$(IMAGEDIR)/cis.bin
cis$(DATASIZE)			=	0x7000
cis$(PATSIZE)			=	$(cis$(DATASIZE))
cis$(BOOTTAB0)			=	$(ipl$(MTDPART)),$(cis$(PATSIZE))(CIS),$(ipl_cust$(MTDPART)),$(uboot$(MTDPART)),$(FLASH_PG_SIZE)@$(boot$(PATSIZE))(ENV)
cis$(SYSTAB)			=	$(kernel$(MTDPART)),$(misc$(MTDPART)),$(rtos$(MTDPART)),$(rootfs$(MTDPART)),$(miservice$(MTDPART)),$(customer$(MTDPART))

# ipl
ipl$(RESOURCE)			=	$(PROJ_ROOT)/board/$(CHIP)/boot/$(FLASH_TYPE)/ipl-dualos/$(IPL_CONFIG)
ipl$(DATASIZE)			=	$(call alignup, $(call filesize, $(ipl$(RESOURCE))), $(FLASH_PG_SIZE))
ipl$(PATSIZE)			=	$(ipl$(DATASIZE))
ipl$(MTDPART)			=	$(ipl$(PATSIZE))(IPL)

# ipl_cust
ipl_cust$(RESOURCE)		=	$(PROJ_ROOT)/board/$(CHIP)/boot/$(FLASH_TYPE)/ipl-dualos/$(IPL_CUST_CONFIG)
ipl_cust$(DATASIZE)		=	$(call alignup, $(call filesize, $(ipl_cust$(RESOURCE))), $(FLASH_PG_SIZE))
ipl_cust$(PATSIZE)		=	$(ipl_cust$(DATASIZE))
ipl_cust$(MTDPART)		=	$(ipl_cust$(PATSIZE))(IPL_CUST)

# uboot
uboot$(RESOURCE)		=	$(PROJ_ROOT)/board/uboot/u-boot.bin
uboot$(DATASIZE)		=	$(call alignup, $(call filesize, $(uboot$(RESOURCE))), $(FLASH_PG_SIZE))
uboot$(PATSIZE)			=	$(uboot$(DATASIZE))
uboot$(MTDPART)			=	$(uboot$(PATSIZE))(UBOOT)

# boot
boot$(RESOURCE)			=	$(IMAGEDIR)/boot.bin
boot$(DATASIZE)			=	$(call sum, $(ipl$(PATSIZE)) $(ipl_cust$(PATSIZE)) $(uboot$(PATSIZE)) $(cis$(PATSIZE)) $(env$(PATSIZE)))
boot$(PATSIZE)			=	$(shell printf 0x%X $(shell expr $(shell printf %d $(call alignup, $(boot$(DATASIZE)), $(FLASH_BLK_SIZE))) - $(shell printf %d $(env$(PATSIZE)))))
boot$(MTDPART)			=	$(boot$(PATSIZE))(BOOT),$(env$(MTDPART))
boot$(OTABLK)			=	/dev/mtd0


# kernel
kernel$(RESOURCE)		=	$(PROJ_ROOT)/kbuild/$(KERNEL_VERSION)/arch/$(ARCH)/boot/uImage
kernel$(DATASIZE)		=	0x800000
kernel$(PATSIZE)		=	$(kernel$(DATASIZE))
kernel$(PATNAME)		=	KERNEL
kernel$(MTDPART)		=	$(kernel$(PATSIZE))(KERNEL)
kernel$(OTABLK)			=	/dev/mtd2
kernel$(BOOTENV)		=	$(KERNEL_BOOT_ENV) loglevel=7
kernel$(OPTIONS)		=	$(subst .,,$(suffix $(kernel$(RESOURCE))))

# ramdisk
ifneq ($(DEBUG), )
ramdisk$(RESOURCE)		=	$(PROJ_ROOT)/release/chip/$(CHIP)/$(PRODUCT)/common/$(TOOLCHAIN)/$(TOOLCHAIN_VERSION)/debug/bin/kernel/$(FLASH_TYPE)/ramdisk
else
ramdisk$(RESOURCE)		=	$(PROJ_ROOT)/release/chip/$(CHIP)/$(PRODUCT)/common/$(TOOLCHAIN)/$(TOOLCHAIN_VERSION)/release/bin/kernel/$(FLASH_TYPE)/ramdisk
endif
ramdisk$(FSTYPE)		=	gz
ramdisk$(PATSIZE)		=	0x60000
ramdisk$(DATASIZE)		=	$$(printf "0x%x" $$(stat -c "%s" $(IMAGEDIR)/ramdisk.img))
ramdisk$(MTDPART)		=	$(ramdisk$(PATSIZE))(RAMDISK)
ramdisk$(BOOTCMD)		=	loados nor by_header RAMDISK by_header\;

# misc
misc$(RESOURCE)			=	$(OUTPUTDIR)/misc
misc$(FSTYPE)			=	fwfs
misc$(PATSIZE)			=	0x120000
misc$(PATNAME)			=	MISC
misc$(MOUNTTG)			=	/misc
misc$(MOUNTPT)			=	/dev/mtd3
misc$(OPTIONS)			=	rw
misc$(MTDPART)			=	$(misc$(PATSIZE))(MISC)
misc$(OTABLK)			=	/dev/mtd3

# miscL
miscL$(RESOURCE)		=	$(OUTPUTDIR)/miscL
miscL$(FSTYPE)			=	fwfs
miscL$(PATSIZE)			=	0x180000
miscL$(PATNAME)			=	MISCL
miscL$(MOUNTTG)			=	/miscL
miscL$(MOUNTPT)			=	/dev/mtd4
miscL$(MTDPART)			=	$(miscL$(PATSIZE))(MISCL)
miscL$(OTABLK)			=	/dev/mtd4

# rtos
rtos$(RESOURCE)			=	$(PROJ_ROOT)/board/rtos/rtos
rtos$(PATSIZE)			=	0x220000
rtos$(PATNAME)			=	RTOS
rtos$(BOOTENV)			=	$(RTOS_BOOT_ENV) mma_base=$(CONFIG_MMA_HEAP_ADDR) mma_size=$(CONFIG_MMA_HEAP_SIZE) rtosrd_addr=$(RTOS_RAMDISK_LOAD_ADDR) rtosrd_size=$(misc$(PATSIZE)) loglevel=7
rtos$(MTDPART)			=	$(rtos$(PATSIZE))(RTOS)
rtos$(BOOTCMD)			=	sf read $(RTOS_LOAD_ADDR) RTOS $(rtos$(PATSIZE))\; dcache off\; bootm $(RTOS_LOAD_ADDR)\;

# rootfs
rootfs$(RESOURCE)		=	$(OUTPUTDIR)/rootfs
rootfs$(FSTYPE)			=	squashfs
rootfs$(PATSIZE)		=	0x210000
rootfs$(MOUNTTG)		=	/usr
rootfs$(MOUNTPT)		=	/dev/mtdblock0
rootfs$(OPTIONS)		=	xz
rootfs$(MTDPART)		=	$(rootfs$(PATSIZE))(rootfs)
rootfs$(OTABLK)			=	/dev/mtd5
rootfs$(BOOTENV)		=	root=/dev/ram rdinit=/linuxrc initrd=$(INITRAMFSLOADADDR),$(ramdisk$(DATASIZE)) rootwait os_adaptor=mma_base=$(CONFIG_MMA_HEAP_ADDR),mma_size=$(CONFIG_MMA_HEAP_SIZE)

# miservice
miservice$(RESOURCE)		=	$(OUTPUTDIR)/miservice/config
miservice$(FSTYPE)		=	squashfs
miservice$(OPTIONS)		=	xz
miservice$(MOUNTTG)		=	/config
miservice$(MOUNTPT)		=	/dev/mtdblock1
miservice$(PATSIZE)		=	0x420000

# customer
customer$(RESOURCE)		=	$(OUTPUTDIR)/customer
customer$(FSTYPE)		=	jffs2
customer$(MOUNTTG)		=	/customer
customer$(MOUNTPT)		=	/dev/mtdblock2
customer$(PATSIZE)		=	0x1FE0000
